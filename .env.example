# ==============================================================================
# Open Event - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!
#
# For detailed documentation, see: docs/ENVIRONMENT_VARIABLES.md
# ==============================================================================

# ==============================================================================
# VITE (Client-side) Variables
# ==============================================================================
# These are exposed to the browser and must be prefixed with VITE_

# Convex deployment URL (REQUIRED)
# Get this from your Convex dashboard: https://dashboard.convex.dev
VITE_CONVEX_URL=https://your-project.convex.cloud

# Sentry DSN for frontend error tracking (Recommended for production)
# Get your DSN at: https://sentry.io
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Stripe publishable key for payments (Required for payment features)
# Get your key at: https://dashboard.stripe.com/apikeys
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ==============================================================================
# CONVEX (Server-side) Variables
# ==============================================================================
# Set these in the Convex Dashboard under Settings > Environment Variables
# These run on Convex's servers and are never exposed to the client.

# -----------------------------------------------------------------------------
# Authentication (Required for production)
# -----------------------------------------------------------------------------

# Site URL for OAuth redirects and magic links (REQUIRED for production)
# SITE_URL=https://your-domain.com

# JWT Private Key for signing tokens (REQUIRED)
# Generate using: openssl genrsa -out private.pem 2048
# Must include BEGIN/END markers
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIEvQIBADANBgkqhkiG9w0BAQEFAASC...
# -----END PRIVATE KEY-----"

# JSON Web Key Set for JWT verification (REQUIRED)
# JWKS={"keys":[{"kty":"RSA","n":"...","e":"AQAB","alg":"RS256","use":"sig"}]}

# Google OAuth (Optional - for "Sign in with Google")
# Get credentials at: https://console.cloud.google.com/apis/credentials
# AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=GOCSPX-your-google-client-secret

# -----------------------------------------------------------------------------
# Email Services (Required for email features)
# -----------------------------------------------------------------------------

# Resend API Key for transactional emails (magic links, notifications)
# Get your API key at: https://resend.com/api-keys
# AUTH_RESEND_KEY=re_...

# Email "From" address for outgoing emails
# EMAIL_FROM=Your App <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# AI Providers (Required for AI features)
# -----------------------------------------------------------------------------

# OpenAI API Key (Primary AI provider)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# Anthropic API Key (Optional - alternative/fallback AI provider)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------------
# Payment Processing (Required for payment features)
# -----------------------------------------------------------------------------

# Stripe Secret Key (server-side)
# Get your key at: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...

# Stripe Publishable Key (backend reference)
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook Secret for verifying webhook signatures
# Get from: Stripe Dashboard > Developers > Webhooks > Signing secret
# STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Error Monitoring (Recommended for production)
# -----------------------------------------------------------------------------

# Sentry DSN for backend error tracking
# Get your DSN at: https://sentry.io
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# -----------------------------------------------------------------------------
# Alerting (Optional)
# -----------------------------------------------------------------------------

# Email address for system alerts
# ALERT_EMAIL=alerts@yourdomain.com

# Slack webhook URL for alert notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# PagerDuty configuration for incident alerts
# PAGERDUTY_API_KEY=your-pagerduty-api-key
# PAGERDUTY_ROUTING_KEY=your-routing-key

# -----------------------------------------------------------------------------
# CORS Configuration (Optional)
# -----------------------------------------------------------------------------

# Additional allowed origins for CORS (comma-separated)
# Default origins include localhost:5173, localhost:3000, openevent.my, openevent.app
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# -----------------------------------------------------------------------------
# Admin Setup (One-time use)
# -----------------------------------------------------------------------------

# Superadmin setup key - generate a secure random string
# Used to promote the first admin user via the Convex dashboard
# After use, you can remove this variable
# Generate with: openssl rand -base64 32
# SUPERADMIN_SETUP_KEY=your-secure-random-string-here

# -----------------------------------------------------------------------------
# Build & Deployment (CI/CD only)
# -----------------------------------------------------------------------------

# Sentry auth token for uploading source maps
# Get from: Sentry Dashboard > Settings > Auth Tokens
# SENTRY_AUTH_TOKEN=sntryu_...

# Sentry organization and project slugs
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=javascript-react

# ==============================================================================
# Environment Mode
# ==============================================================================
# NODE_ENV=development | staging | production
